        <defaultValue xmi:type="expression:Expression" xmi:id="_RKkzh6cUEfGN75PMObyQsw" name="initDetalleOferta()" content="def detalleOfertaVar = new com.company.model.DetalleOferta()&#xD;&#xA;detalleOfertaVar.lote = {&#xD;&#xA;&#x9;//Retrieve aggregated LoteDeNecesidades using its DAO and persistenceId&#xD;&#xA;&#x9;def loteDeNecesidadesVar = loteDeNecesidadesDAO.findByPersistenceId(detalleOfertaInput?.lote?.persistenceId_string?.trim() ? detalleOfertaInput.lote.persistenceId_string.toLong() : null)&#xD;&#xA;&#x9;if (!loteDeNecesidadesVar) {&#xD;&#xA;&#x9;&#x9;if (detalleOfertaInput?.lote?.persistenceId_string?.trim() ? detalleOfertaInput.lote.persistenceId_string.toLong() : null) {&#xD;&#xA;&#x9;&#x9;&#x9;throw new IllegalArgumentException(&quot;The aggregated reference of type `LoteDeNecesidades` with the persistence id &quot; + detalleOfertaInput?.lote?.persistenceId_string?.trim() ? detalleOfertaInput.lote.persistenceId_string.toLong() : null + &quot; has not been found.&quot;)&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;return null&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;return loteDeNecesidadesVar}()&#xD;&#xA;detalleOfertaVar.cantidadOfrecida = detalleOfertaInput?.cantidadOfrecida&#xD;&#xA;return detalleOfertaVar" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="com.company.model.DetalleOferta">
