            <rightOperand xmi:type="expression:Expression" xmi:id="_olpIEqcaEfGN75PMObyQsw" name="CambiarEstados" content="&#xD;&#xA;&#xD;&#xA;List idsSeleccionados = ofertasSeleccionadasIds as List&#xD;&#xA;&#xD;&#xA;// 2. Recorremos las ofertas asociadas a la emergencia&#xD;&#xA;if (emergenciaActual != null &amp;&amp; emergenciaActual.ofertas != null) {&#xD;&#xA;    emergenciaActual.ofertas.each { oferta ->&#xD;&#xA;        // Convertimos a Long para comparar sin problemas de tipo con persistenceId&#xD;&#xA;        if (idsSeleccionados.any { it.toLong() == oferta.persistenceId }) {&#xD;&#xA;            oferta.estado = &quot;ADJUDICADA&quot;&#xD;&#xA;        } else {&#xD;&#xA;            oferta.estado = &quot;DESESTIMADA&quot;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// 3. Retornamos el objeto BDM actualizado&#xD;&#xA;return emergenciaActual" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="com.company.model.Emergencia">
