  "variables" : {
    "task" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "emergenciaActual" : {
      "type" : "url",
      "value" : [
        "../{{context.emergenciaActual_ref.link}}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.emergenciaActual ){",
        "\treturn {",
        "\t\t//map emergenciaActual variable to expected task contract input",
        "\t\temergenciaActualInput: {",
        "\t\t\ttipoDesastre: $data.emergenciaActual.tipoDesastre !== undefined ? $data.emergenciaActual.tipoDesastre : null,",
        "\t\t\tnivelGravedad: $data.emergenciaActual.nivelGravedad !== undefined ? $data.emergenciaActual.nivelGravedad : null,",
        "\t\t\tzonaAfectada: $data.emergenciaActual.zonaAfectada !== undefined ? $data.emergenciaActual.zonaAfectada : null,",
        "\t\t\tdescripcion: $data.emergenciaActual.descripcion !== undefined ? $data.emergenciaActual.descripcion : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "taskId" : {
      "type" : "urlparameter",
      "value" : [
        "id"
      ],
